<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paw_background">

    <LinearLayout
        android:id="@+id/historyDetailHeader"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:minHeight="64dp" android:padding="8dp" android:paddingEnd="72dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/paw_header_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageButton
            android:id="@+id/btnHistoryBack"
            android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back" app:tint="@color/paw_on_header"
            android:contentDescription="@string/pet_back" />
        <TextView
            android:id="@+id/tvHistoryDetailTitle"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingHorizontal="8dp" android:text="@string/history_detail_adoption_title"
            android:textSize="20sp" android:textStyle="bold" android:textColor="@color/paw_on_header" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/historyDetailScroll"
        android:layout_width="0dp" android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/historyDetailHeader"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView
                android:id="@+id/tvHistoryDetailUnavailable"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="24dp" android:gravity="center"
                android:text="@string/pet_detail_unavailable"
                android:textColor="@color/paw_text_secondary" android:visibility="gone" />
            <LinearLayout
                android:id="@+id/historyDetailContent"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgHistoryPet"
                    android:layout_width="match_parent" android:layout_height="180dp"
                    android:scaleType="centerCrop" android:background="@color/paw_surface"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PawMatch.Card" />
                <TextView
                    android:id="@+id/tvHistoryPetName"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textSize="26sp"
                    android:textStyle="bold" android:textColor="@color/paw_text_primary" />
                <TextView
                    android:id="@+id/tvHistoryDetailStatus"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:background="@drawable/bg_request_status"
                    android:paddingHorizontal="10dp" android:paddingVertical="4dp"
                    android:textSize="13sp" android:textStyle="bold" android:textColor="@color/paw_primary" />
                <TextView
                    android:id="@+id/tvHistoryPetSummary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/paw_text_secondary" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/paw_surface" app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/pet_detail_state_title"
                            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/paw_primary" />
                        <TextView
                            android:id="@+id/tvPetDetailStateBody"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite"
                            android:textSize="14sp" android:textColor="@color/paw_text_primary" />
                        <Button
                            android:id="@+id/btnPetDetailRequest"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/pm_me_interesa"
                            android:backgroundTint="@color/paw_primary" android:textColor="@color/paw_on_primary"
                            android:visibility="gone" />
                        <LinearLayout
                            android:id="@+id/petDetailDecisionActions"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:orientation="horizontal"
                            android:visibility="gone">
                            <Button
                                android:id="@+id/btnPetDetailReject"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:layout_marginEnd="6dp"
                                android:text="@string/pm_request_reject" android:textColor="@color/paw_text_primary"
                                app:strokeColor="@color/paw_border" />
                            <Button
                                android:id="@+id/btnPetDetailAccept"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:layout_marginStart="6dp"
                                android:text="@string/pm_request_accept"
                                android:backgroundTint="@color/paw_primary" android:textColor="@color/paw_on_primary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/paw_surface" app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/pet_detail_publisher_title"
                            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/paw_primary" />
                        <TextView
                            android:id="@+id/tvPetPublisherName"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:textSize="17sp"
                            android:textStyle="bold" android:textColor="@color/paw_text_primary" />
                        <TextView
                            android:id="@+id/tvPetPublisherContact"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/paw_text_secondary" />
                        <TextView
                            android:id="@+id/tvPetPublisherLocation"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/paw_text_secondary"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/petDetailAdopterCard"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/paw_surface" app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView
                            android:id="@+id/tvPetDetailApplicantTitle"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/history_detail_adopter_title"
                            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/paw_primary" />
                        <LinearLayout
                            android:id="@+id/historyAdopterInfo"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:layout_marginTop="8dp">
                            <TextView
                                android:id="@+id/tvHistoryAdopterName"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:textSize="17sp" android:textStyle="bold" android:textColor="@color/paw_text_primary" />
                            <TextView
                                android:id="@+id/tvHistoryAdopterEmail"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/paw_text_secondary" />
                            <TextView
                                android:id="@+id/tvHistoryAdopterLocation"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/paw_text_secondary" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvHistoryNoAdopter"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:textSize="14sp"
                            android:textColor="@color/paw_text_secondary" android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/petDetailChatCard"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/paw_surface" app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/history_detail_chat_title"
                            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/paw_primary" />
                        <TextView
                            android:id="@+id/tvHistoryChatPreview"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:maxLines="3" android:ellipsize="end"
                            android:textSize="14sp" android:textColor="@color/paw_text_secondary" />
                        <Button
                            android:id="@+id/btnHistoryOpenChat"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/chat_open"
                            android:backgroundTint="@color/paw_primary" android:textColor="@color/paw_on_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/paw_surface" app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/history_detail_pet_title"
                            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/paw_primary" />
                        <TextView
                            android:id="@+id/tvPetDetailAge"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/paw_text_primary" />
                        <TextView
                            android:id="@+id/tvPetDetailCity"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/paw_text_primary" />
                        <TextView
                            android:id="@+id/tvHistoryPetBirth"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/paw_text_primary" />
                        <TextView
                            android:id="@+id/tvHistoryPetWeight"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/paw_text_primary" />
                        <TextView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:text="@string/pet_temperament"
                            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/paw_text_primary" />
                        <TextView
                            android:id="@+id/tvHistoryPetTemperament"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/paw_text_secondary" />
                        <TextView
                            android:id="@+id/tvPetDetailAbout"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:textSize="15sp"
                            android:textStyle="bold" android:textColor="@color/paw_text_primary" />
                        <TextView
                            android:id="@+id/tvHistoryPetStory"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:lineSpacingExtra="3dp"
                            android:textSize="14sp" android:textColor="@color/paw_text_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp" android:layout_height="@dimen/paw_bottom_navigation_height"
        android:background="@color/paw_surface" app:elevation="8dp"
        app:itemIconTint="@color/paw_primary" app:itemTextColor="@color/paw_primary"
        app:labelVisibilityMode="labeled" app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
