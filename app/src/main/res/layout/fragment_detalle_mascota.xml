<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paw_cream">

    <!-- Top Bar con Botón Volver y Título -->
    <LinearLayout
        android:id="@+id/top_bar_detalle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_volver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ic_paw_huella"
            android:backgroundTint="@color/paw_white"
            android:contentDescription="Volver"
            android:elevation="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/paw_green" />

        <TextView
            android:id="@+id/tv_titulo_detalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Detalle de Mascota"
            android:textColor="@color/paw_dark"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contenido Scrollable -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_container_detalle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar_detalle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card de Imagen Principal con 24dp de Bordes Redondeados -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="260dp"
                app:cardBackgroundColor="@color/paw_white"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:cardPreventCornerOverlap="true"
                app:strokeColor="@color/paw_gray"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:id="@+id/img_detalle_mascota"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/pm_app_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_luna_img" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Nombre y Especie -->
            <TextView
                android:id="@+id/tv_nombre_detalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Luna"
                android:textColor="@color/paw_dark"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_especie_tamano_detalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Perro • Mediano"
                android:textColor="@color/paw_gray"
                android:textSize="16sp" />

            <!-- Fichas de Métricas: Nacimiento y Ciudad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/paw_white"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/paw_gray"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nacimiento"
                            android:textColor="@color/paw_gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_val_nacimiento"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Marzo 2022"
                            android:textColor="@color/paw_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/paw_white"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/paw_gray"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ciudad"
                            android:textColor="@color/paw_gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_val_ciudad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Santa Fe"
                            android:textColor="@color/paw_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Fichas de Métricas: Peso y Edad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/paw_white"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/paw_gray"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Peso"
                            android:textColor="@color/paw_gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_val_peso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="14 kg"
                            android:textColor="@color/paw_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/paw_white"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/paw_gray"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edad"
                            android:textColor="@color/paw_gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_val_edad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="2 años"
                            android:textColor="@color/paw_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Card Temperamento -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/paw_white"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/paw_gray"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Temperamento"
                        android:textColor="@color/paw_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_val_temperamento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tranquila y cariñosa"
                        android:textColor="@color/paw_gray"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Historia -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/paw_white"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/paw_gray"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_titulo_historia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sobre Luna"
                        android:textColor="@color/paw_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_val_historia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:text="Luna fue rescatada a los 6 meses. Disfruta enormemente los paseos en parques y convive alegremente con niños."
                        android:textColor="@color/paw_gray"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Contenedor Inferior con Botón de Acción -->
    <LinearLayout
        android:id="@+id/bottom_container_detalle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/paw_white"
        android:elevation="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_interes_detalle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/paw_green"
            android:text="Me interesa adoptar a Luna"
            android:textColor="@color/paw_white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="24dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
