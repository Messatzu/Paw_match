<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/pm_titulo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="22sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/pm_provisional" android:paddingTop="8dp" />
        <TextView android:id="@+id/pm_contenido" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="16dp" android:textIsSelectable="true" />
        <Button android:id="@+id/pm_crear" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/pm_crear" />
        <Button android:id="@+id/pm_aprobar" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/pm_aprobar" />
        <Button android:id="@+id/pm_rechazar" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/pm_rechazar" />
    </LinearLayout>
</ScrollView>
