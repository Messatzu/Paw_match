<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:id="@+id/pm_modo" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="12dp" android:textSize="20sp" />
    <Button android:id="@+id/pm_cambiar_modo" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/pm_cambiar_modo" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/pm_explorar" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/pm_explorar" />
        <Button android:id="@+id/pm_solicitudes" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/pm_solicitudes" />
    </LinearLayout>
    <Button android:id="@+id/pm_reiniciar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/pm_reiniciar" />
    <androidx.fragment.app.FragmentContainerView android:id="@+id/pm_contenedor"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
