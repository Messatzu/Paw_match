<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paw_background">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/pm_contenedor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <ProgressBar
        android:id="@+id/authProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/paw_primary" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnToggleTheme"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:padding="12dp"
        android:background="@drawable/bg_theme_toggle"
        android:contentDescription="@string/appearance_enable_dark"
        app:srcCompat="@drawable/ic_theme_moon" />
</FrameLayout>
