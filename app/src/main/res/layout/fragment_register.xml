<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingTop="56dp"
    android:clipToPadding="true"
    android:background="@color/paw_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <com.example.paw_match.ui.shared.BrandBannerView
            android:id="@+id/imgAuthBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxHeight="120dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_paw_huella"
            android:contentDescription="@string/paw_match_brand"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_register_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/paw_primary"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auth_name_hint"
            android:inputType="textPersonName|textCapWords"
            android:autofillHints="name"
            android:textColorHint="@color/paw_text_secondary"
            android:textColor="@color/paw_text_primary"
            android:backgroundTint="@color/paw_primary"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etEmailReg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auth_email_hint"
            android:textColorHint="@color/paw_text_secondary"
            android:textColor="@color/paw_text_primary"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:backgroundTint="@color/paw_primary"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etPasswordReg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auth_password_hint"
            android:textColorHint="@color/paw_text_secondary"
            android:textColor="@color/paw_text_primary"
            android:inputType="textPassword"
            android:autofillHints="newPassword"
            android:saveEnabled="false"
            android:backgroundTint="@color/paw_primary"
            android:layout_marginBottom="16dp" />


        <EditText
            android:id="@+id/etUserLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auth_location_hint"
            android:inputType="textPostalAddress|textCapWords"
            android:textColorHint="@color/paw_text_secondary"
            android:textColor="@color/paw_text_primary"
            android:backgroundTint="@color/paw_primary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_role_prompt"
            android:textColor="@color/paw_text_primary"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbAdoptante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_role_adoptante"
                android:textColor="@color/paw_text_primary"
                android:checked="true"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/rbPublicador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_role_publicador"
                android:textColor="@color/paw_text_primary" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvAuthError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/paw_text_error"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_register"
            android:textColor="@color/paw_on_primary"
            android:backgroundTint="@color/paw_primary" />

        <Button
            android:id="@+id/btnBackToLogin"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auth_back_to_login"
            android:textColor="@color/paw_primary" />

    </LinearLayout>
</ScrollView>
