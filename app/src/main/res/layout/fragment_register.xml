<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/paw_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear Cuenta"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/paw_green"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre o Refugio"
            android:textColorHint="@color/paw_gray"
            android:textColor="@color/paw_dark"
            android:backgroundTint="@color/paw_green"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etEmailReg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Correo electrónico"
            android:textColorHint="@color/paw_gray"
            android:textColor="@color/paw_dark"
            android:inputType="textEmailAddress"
            android:backgroundTint="@color/paw_green"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etPasswordReg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña"
            android:textColorHint="@color/paw_gray"
            android:textColor="@color/paw_dark"
            android:inputType="textPassword"
            android:backgroundTint="@color/paw_green"
            android:layout_marginBottom="16dp" />


        <EditText
            android:id="@+id/etUserLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ciudad / Ubicación (ej. Santa Fe)"
            android:textColorHint="@color/paw_gray"
            android:textColor="@color/paw_dark"
            android:backgroundTint="@color/paw_green"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona tu rol:"
            android:textColor="@color/paw_dark"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbAdoptante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adoptante"
                android:textColor="@color/paw_dark"
                android:checked="true"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/rbPublicador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publicador"
                android:textColor="@color/paw_dark" />
        </RadioGroup>

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrarse"
            android:textColor="@color/paw_white"
            android:backgroundTint="@color/paw_green" />

    </LinearLayout>
</ScrollView>