<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/requestPetCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/paw_surface"
    app:rippleColor="@color/paw_accent"
    app:cardCornerRadius="35dp"
    app:cardElevation="4dp"
    app:cardPreventCornerOverlap="false"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.PawMatch.Card"
    app:strokeColor="@color/paw_border"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgRequestPet"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/paw_surface_variant"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PawMatch.TopRounded"
            tools:src="@drawable/ic_luna_img" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPetRequestTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:textColor="@color/paw_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="Luna" />

                <TextView
                    android:id="@+id/tvRequestStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_request_status"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="@string/pm_pendiente"
                    android:textColor="@color/paw_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPetRequestDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/paw_text_secondary"
                android:textSize="15sp"
                tools:text="2 años • Santa Fe" />

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/pet_view_details"
                android:textSize="13sp" android:textStyle="bold" android:textColor="@color/paw_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/pm_request_applicant"
                android:textColor="@color/paw_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvApplicantName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/paw_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Alex Demo" />

            <TextView
                android:id="@+id/tvApplicantLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/paw_text_secondary"
                android:textSize="14sp"
                tools:text="Vive en Santa Fe" />

            <TextView
                android:id="@+id/tvApplicantBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/paw_text_primary"
                android:textSize="14sp"
                tools:text="Busco un compañero y dispongo de tiempo para cuidarlo." />

            <LinearLayout
                android:id="@+id/requestActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReject"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/pm_request_reject"
                    android:textColor="@color/paw_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PawMatch.Button"
                    app:strokeColor="@color/paw_border"
                    app:strokeWidth="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccept"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/paw_primary"
                    android:text="@string/pm_request_accept"
                    android:textColor="@color/paw_on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PawMatch.Button" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
