<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/paw_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Publicar Nueva Mascota"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/paw_green"
            android:layout_marginBottom="24dp" />

        <ImageView
            android:id="@+id/imgPetPreview"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:background="@color/paw_gray"
            android:layout_marginBottom="12dp"
            android:contentDescription="Foto de la mascota" />

        <Button
            android:id="@+id/btnSelectPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleccionar Foto"
            android:textColor="@color/paw_white"
            android:backgroundTint="@color/paw_coral"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etPetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la mascota"
            android:textColorHint="@color/paw_gray"
            android:textColor="@color/paw_dark"
            android:backgroundTint="@color/paw_green"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etPetAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Edad y Ubicación (ej. 2 años • Santa Fe)"
            android:textColorHint="@color/paw_gray"
            android:textColor="@color/paw_dark"
            android:backgroundTint="@color/paw_green"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etPetDescription"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Descripción y detalles..."
            android:textColorHint="@color/paw_gray"
            android:textColor="@color/paw_dark"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:backgroundTint="@color/paw_green"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSavePet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Publicar Mascota"
            android:textColor="@color/paw_white"
            android:backgroundTint="@color/paw_green" />

    </LinearLayout>
</ScrollView>