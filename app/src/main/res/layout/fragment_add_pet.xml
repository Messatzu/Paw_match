<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingTop="56dp"
    android:clipToPadding="true"
    android:background="@color/paw_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pet_add_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/paw_primary"
            android:layout_marginBottom="24dp" />

        <ImageView
            android:id="@+id/imgPetPreview"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:background="@color/paw_border"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/pet_photo_description" />

        <Button
            android:id="@+id/btnSelectPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pet_select_photo"
            android:textColor="@color/paw_on_accent"
            android:backgroundTint="@color/paw_accent"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etPetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pet_name_hint"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:textColorHint="@color/paw_text_secondary"
            android:textColor="@color/paw_text_primary"
            android:backgroundTint="@color/paw_primary"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etPetAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pet_age_hint"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:textColorHint="@color/paw_text_secondary"
            android:textColor="@color/paw_text_primary"
            android:backgroundTint="@color/paw_primary"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etPetLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pet_location_hint"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:textColorHint="@color/paw_text_secondary"
            android:textColor="@color/paw_text_primary"
            android:backgroundTint="@color/paw_primary"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etPetDescription"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="@string/pet_description_hint"
            android:textColorHint="@color/paw_text_secondary"
            android:textColor="@color/paw_text_primary"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:backgroundTint="@color/paw_primary"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSavePet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pet_publish"
            android:textColor="@color/paw_on_primary"
            android:backgroundTint="@color/paw_primary" />

    </LinearLayout>
</ScrollView>
