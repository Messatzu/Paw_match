<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/paw_cream">

    <!-- Logo oficial de Paw Match -->
    <ImageView
        android:layout_width="220dp"
        android:layout_height="80dp"
        android:src="@drawable/logo_paw_match"
        android:scaleType="fitCenter"
        android:layout_marginBottom="24dp"
        android:contentDescription="Logo Paw Match" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Iniciar Sesión"
        android:textSize="18sp"
        android:textColor="@color/paw_dark"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Correo electrónico"
        android:textColorHint="@color/paw_gray"
        android:textColor="@color/paw_dark"
        android:inputType="textEmailAddress"
        android:backgroundTint="@color/paw_green"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Contraseña"
        android:textColorHint="@color/paw_gray"
        android:textColor="@color/paw_dark"
        android:inputType="textPassword"
        android:backgroundTint="@color/paw_green"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingresar"
        android:textColor="@color/paw_white"
        android:backgroundTint="@color/paw_green"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnGoToRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿No tienes cuenta? Regístrate"
        android:textColor="@color/paw_green"
        style="?attr/materialButtonOutlinedStyle" />

</LinearLayout>